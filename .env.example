APP_NAME="نوبت‌دهی بارگیری"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Asia/Tehran

# پروکسی‌های مورد اعتماد برای X-Forwarded-For — پیش‌فرض فقط همین ماشین.
# پشت Cloudflare یا لود بالانسر، رنج واقعی آن‌ها را با کاما بنویسید.
# '*' یعنی هر کسی می‌تواند IP خودش را جعل کند؛ آگاهانه انتخابش کنید.
TRUSTED_PROXIES=127.0.0.1,::1

APP_LOCALE=fa
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=nobatdehi
DB_USERNAME=nobat
DB_PASSWORD=nobat

SESSION_DRIVER=redis
SESSION_LIFETIME=120
# نشست رمزنگاری‌شده: Redis که dump شود یا از شبکه‌ی داخلی خوانده شود،
# session قابل استفاده نمی‌دهد
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

OTP_LENGTH=6
OTP_TTL_MINUTES=2
OTP_MAX_ATTEMPTS=5
OTP_RESEND_SECONDS=60
OTP_EXPOSE_IN_RESPONSE=false

REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST="localhost"
REVERB_PORT=8080

# Reverb فقط روی لوپ‌بک گوش می‌دهد و از پشت Nginx سرو می‌شود.
# 0.0.0.0 یعنی WebSocket بدون TLS مستقیم از اینترنت قابل دسترس است.
REVERB_SERVER_HOST=127.0.0.1
REVERB_SERVER_PORT=8080
REVERB_SCHEME=http

# VITE_REVERB_HOST را روی سرور خالی بگذارید.
#
# این مقدار در زمان build داخل جاوااسکریپت پخته می‌شود. اگر پر باشد و بعداً
# دامنه عوض شود، مرورگر تا وقتی کسی دوباره build نگیرد سراغ میزبان قبلی
# می‌رود و اتصال زنده بی‌صدا می‌میرد. خالی که باشد، آدرس از خودِ صفحه
# خوانده می‌شود و همیشه درست است.
#
# فقط در محیط توسعه پرش کنید، جایی که Vite روی ۸۰۰۰ است و Reverb روی ۸۰۸۰.
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# تنظیمات پنل پیامک در پنل مدیریت است، نه اینجا: /panel/settings/sms

# اثر انگشتِ SHA-256 کلیدی که APK راننده با آن امضا شده.
#
# با این، لینکِ پیامک مستقیم داخل برنامه باز می‌شود و نه در مرورگر.
# مقدارش را build-apk.sh بعد از ساخت چاپ می‌کند. خالی که باشد، پیوند
# برقرار نمی‌شود و همه‌چیز مثل قبل کار می‌کند.
ANDROID_FINGERPRINTS=
ANDROID_PACKAGE=ir.nobatdehi.driver
